# Copie este arquivo para ".env.local" e preencha os valores.
# Sem estas variáveis o app funciona em "modo demonstração".

# Inteligência artificial (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=
# Opcional: modelo usado para gerar receitas (padrão: claude-opus-5-5)
# ANTHROPIC_MODEL=

# Login e banco de dados (supabase.com > seu projeto > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
